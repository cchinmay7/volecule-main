# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase service role key — used server-side only (bypasses RLS for ingestion and reminders)
# https://app.supabase.com/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that Google Apps Script must include in the X-Volecule-Secret header
INGESTION_SHARED_SECRET=change-me-to-a-strong-random-secret

# WhatsApp provider (placeholder — wire up your chosen provider in src/lib/whatsapp.ts)
# WHATSAPP_API_URL=https://your-provider/api/send
# WHATSAPP_API_KEY=your-key
# WHATSAPP_TEMPLATE_NAME=hello_world
# WHATSAPP_TEMPLATE_LANG=en_US
# WHATSAPP_TEMPLATE_BODY_VAR1_MODE=form_url
# WHATSAPP_TEMPLATE_BUTTON_URL_VAR1_MODE=form_url
# WHATSAPP_TEMPLATE_BUTTON_INDEX=0
